<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    Title="Task Planner"
    Shell.TabBarIsVisible="True">

    <!-- Для Android - Bottom Tabs -->
    <TabBar>
        <Tab Title="Задачи" Icon="tasks.png">
            <ShellContent ContentTemplate="{DataTemplate local:TasksPage}" Route="TasksPage" />
        </Tab>
        <Tab Title="Календарь" Icon="calendar.png">
            <ShellContent ContentTemplate="{DataTemplate local:CalendarPage}" Route="CalendarPage" />
        </Tab>
        <Tab Title="Настройки" Icon="settings.png">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>
</Shell>