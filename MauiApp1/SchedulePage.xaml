<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.SchedulePage"
             Title="Все задачи">
    <ContentPage.Resources>
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Grid BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                  Padding="12,6">
                <Label Text="{Binding Key, StringFormat='{0:dddd, d MMMM yyyy}'}"
                       FontAttributes="Bold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"/>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <CollectionView ItemsSource="{Binding GroupedTasks}"
                    IsGrouped="True"
                    GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="12,8">
                    <Label
                           Text="{Binding Title}"
                           FontSize="14"
                           VerticalOptions="Center">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                <Setter Property="TextColor" Value="Gray"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>