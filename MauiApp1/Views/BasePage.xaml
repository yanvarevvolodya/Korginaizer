<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.BasePage"
             x:Name="BasePageContent"
             NavigationPage.HasNavigationBar="False">

    <Grid x:Name="MainGrid"
          RowDefinitions="Auto, *"
          RowSpacing="0">

        <!-- Шапка (ОБЩАЯ ДЛЯ ВСЕХ) -->
        <Grid Grid.Row="0"
              BackgroundColor="#00008B"
              HeightRequest="60">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка для специфичных функций страницы -->
            <ContentPresenter Grid.Column="0" 
                              x:Name="HeaderButtonArea"/>

            <Label x:Name="HeaderTitleLabel" Grid.Column="1"
                   Text="Заголовок" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Start"
                   FontSize="18"
                   TextColor="White"
                   FontAttributes="Bold"
                   Margin="30,0"/>
        </Grid>

        <!-- ОБЛАСТЬ КОНТЕНТА (заполняется наследниками) -->
        <ContentPresenter Grid.Row="1"
                          x:Name="PageContentArea"/>

    </Grid>
</ContentPage>