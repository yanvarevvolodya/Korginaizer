<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.BasePage"
             x:Name="BasePageContent"
             NavigationPage.HasNavigationBar="False">

    <Grid ColumnDefinitions="70, *"  
          RowDefinitions="Auto, *"
          RowSpacing="0">

        <!-- Боковая панель (ОБЩАЯ ДЛЯ ВСЕХ) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
              BackgroundColor="#000033"
              ZIndex="999">
            <StackLayout Padding="0,40,0,0">
                <Button x:Name="TasksButton" 
                        ImageSource="tasks_icon.png" Text="Задачи" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnTasksButtonClicked"/>

                <Button x:Name="CalendarButton" 
                        ImageSource="calendar_icon.png" Text="Календарь" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnCalendarButtonClicked"/>

                <Button x:Name="SettingsButton" 
                        ImageSource="settings_icon.png" Text="Настройки" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnSettingsButtonClicked"/>
            </StackLayout>
        </Grid>

        <!-- Шапка (ОБЩАЯ ДЛЯ ВСЕХ) -->
        <Grid Grid.Row="0" Grid.Column="1"
              BackgroundColor="#00008B"
              HeightRequest="60">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка для специфичных функций страницы -->
            <ContentPresenter Grid.Column="0" 
                              x:Name="HeaderButtonArea"/>

            <Label x:Name="HeaderTitleLabel" Grid.Column="1"
                   Text="Заголовок" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Start"
                   FontSize="18"
                   TextColor="White"
                   FontAttributes="Bold"
                   Margin="30,0"/>
        </Grid>

        <!-- ОБЛАСТЬ КОНТЕНТА (заполняется наследниками) -->
        <ContentPresenter Grid.Row="1" Grid.Column="1"
                          x:Name="PageContentArea"/>

    </Grid>
</ContentPage>