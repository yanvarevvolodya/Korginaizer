<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.TasksContent">

    <Grid ColumnDefinitions="200, *" RowDefinitions="*">

        <!-- Зелёная панель ТОЛЬКО для задач -->
        <Grid x:Name="CategoriesPanel" Grid.Column="0" BackgroundColor="#000062">
            <StackLayout Spacing="10" Padding="10,40,10,0">
                <Button Text="Создать список" BackgroundColor="#000033" TextColor="White"/>
                <Label Text="Мои списки:" TextColor="White" FontAttributes="Bold"/>
                <Button Text="Личные" BackgroundColor="Transparent" TextColor="White"/>
                <Button Text="Работа" BackgroundColor="Transparent" TextColor="White"/>
                <Button Text="Покупки" BackgroundColor="Transparent" TextColor="White"/>
            </StackLayout>
        </Grid>

        <!-- Область задач -->
        <ScrollView x:Name="TasksArea" Grid.Column="1">
            <StackLayout Padding="20">
                <Label Text="Список задач..." FontSize="16" TextColor="White"/>
                <Frame BackgroundColor="#f5f5f5" Padding="15">
                    <Label Text="Пример задачи 1"/>
                </Frame>
                <Frame BackgroundColor="#f5f5f5" Padding="15">
                    <Label Text="Пример задачи 2"/>
                </Frame>
            </StackLayout>
        </ScrollView>

    </Grid>

</ContentView>