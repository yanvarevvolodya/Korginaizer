<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TasksPage">

    <Grid ColumnDefinitions="70, *"  
          RowDefinitions="Auto, *"
          RowSpacing="0">

        <!-- Боковая панель -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
      BackgroundColor="#000033"
      x:Name="SidePanel">
            <StackLayout Padding="0,40,0,0">
                <Button ImageSource="tasks_icon.png" Text="Задачи" 
                BackgroundColor="Transparent" TextColor="White" 
                HeightRequest="70"
                Clicked="OnTasksButtonClicked"/>

                <Button ImageSource="calendar_icon.png" Text="Календарь" 
                BackgroundColor="Transparent" TextColor="White" 
                HeightRequest="70"
                Clicked="OnCalendarButtonClicked"/>

                <Button ImageSource="settings_icon.png" Text="Настройки" 
                BackgroundColor="Transparent" TextColor="White" 
                HeightRequest="70"
                Clicked="OnSettingsButtonClicked"/>
            </StackLayout>
        </Grid>

        <!-- Шапка контента -->
        <Grid Grid.Row="0" Grid.Column="1"
      BackgroundColor="#00008B"
      HeightRequest="60">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка выдвижения зеленой панели -->
            <Button Grid.Column="0"
            Text="☰"
            BackgroundColor="Transparent"
            WidthRequest="60"
            x:Name="ToggleCategoriesButton"
            Clicked="OnToggleCategoriesButtonClicked"/>

            <Label x:Name="HeaderTitleLabel" Grid.Column="1"
           Text="Задачи" 
           VerticalOptions="Center" 
           HorizontalOptions="Start"
           FontSize="18"
           TextColor="White"
           FontAttributes="Bold"
           Margin="30,0"/>
        </Grid>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Grid.Column="1">

            <!-- Внутренний Grid для организации контента -->
            <Grid ColumnDefinitions="200, *" RowDefinitions="*">

                <!-- ОБЛАСТЬ ДЛЯ СМЕНЫ КОНТЕНТА -->
                <ContentView Grid.Column="0" x:Name="MainContentArea">

                    <!-- Стартовый контент - Tasks Content -->
                    <ScrollView>
                        <StackLayout Padding="20">
                            <Label Text="Список задач..." FontSize="16" TextColor="White"/>
                            <Frame BackgroundColor="#f5f5f5" Padding="15">
                                <Label Text="Пример задачи 1"/>
                            </Frame>
                            <Frame BackgroundColor="#f5f5f5" Padding="15">
                                <Label Text="Пример задачи 2"/>
                            </Frame>
                        </StackLayout>
                    </ScrollView>

                </ContentView>

            </Grid>
        </Grid>

    </Grid>
</ContentPage>