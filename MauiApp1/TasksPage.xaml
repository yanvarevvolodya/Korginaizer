<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TasksPage"
             x:Name="TasksPageRoot">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *"
          ColumnDefinitions="Auto, *, Auto, Auto"
          Padding="0"
          RowSpacing="10"
          ColumnSpacing="10">

        <!-- Заголовок с кнопкой -->
        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Button x:Name="ToggleButton"
                    Text="☰"
                    BackgroundColor="Transparent"     
                    WidthRequest="60"
                    HeightRequest="60"
                    Command="{Binding ToggleSidePanelCommand}"/>

            <Label Text="Задачи" 
                   Margin="25"
                   TextColor="AliceBlue"
                   VerticalTextAlignment="Center"/>
        </HorizontalStackLayout>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
              RowDefinitions="Auto, Auto, Auto, *"
              ColumnDefinitions="*, Auto"
              Margin="0">

            <!-- ПРИВЕТСТВИЕ И ВЫБРАННЫЙ СПИСОК -->
            <StackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                  Margin="0,0,0,20">
                

                <Label Text="{Binding SelectedList.Name, StringFormat='{0}'}"
               FontSize="16"
               TextColor="White"
                       HorizontalTextAlignment="Center"
               IsVisible="{Binding SelectedList, Converter={StaticResource NullToBoolConverter}}"/>
            </StackLayout>

            <!-- Добавление новой задачи -->
            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
          ColumnDefinitions="*, Auto"
          Margin="0,0,0,15">
                <Entry Grid.Row="0" Grid.Column="0"
               Placeholder="Добавить задачу..."
               PlaceholderColor="LightSlateGray"
               Text="{Binding NewTaskTitle}"
               Completed="OnEntryCompleted" />
                <Button Grid.Row="0" Grid.Column="1"
                Text="+ Задача"
                Command="{Binding AddTaskCommand}"
                BackgroundColor="#28A745"
                TextColor="White"
                WidthRequest="80" />
            </Grid>

            <!-- Список задач -->
            <CollectionView Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    ItemsSource="{Binding Tasks}"
                    Margin="0,10,0,0">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10"
                              ColumnDefinitions="Auto, *, Auto"
                              BackgroundColor="#404346"    
                              Opacity="0.9"
                              Margin="0,2">

                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsCompleted}"
                                      VerticalOptions="Center"
                                      Color="#007ACC"
                                      CheckedChanged="OnTaskCheckedChanged" />

                            <Label Grid.Column="1"
                                   Text="{Binding Title}"
                                   VerticalOptions="Center"
                                   FontSize="16">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsCompleted}"
                                                 Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="TextColor" Value="#6C757D" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <Button Grid.Column="2"
                                    Text="✕"
                                    BackgroundColor="Transparent"
                                    TextColor="#DC3545"
                                    FontSize="12"
                                    Clicked="OnDeleteTaskClicked" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- ВЫДВИЖНАЯ ПАНЕЛЬ - ОТДЕЛЬНЫЙ СЛОЙ ПОВЕРХ ВСЕГО КОНТЕНТА -->
        <Frame x:Name="SidePanel"
       Grid.Row="1" Grid.RowSpan="5" Grid.Column="0"
       WidthRequest="{Binding SidePanelWidth}"
       HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=Height}"
       HorizontalOptions="Start"
       VerticalOptions="Start"
       BackgroundColor="Transparent"
       Padding="0"
       CornerRadius="0"
       HasShadow="True"
       ZIndex="999"
       IsVisible="{Binding IsSidePanelVisible}">

            <!-- Вертикальный контейнер для всей панели -->
            <StackLayout Spacing="0"
                 VerticalOptions="Start">

                <!-- Кнопка создания списка -->
                <Button Text="+ Создать список" 
                HeightRequest="50"
                BackgroundColor="#2A1376"
                TextColor="White"
                FontSize="14"
                Command="{Binding ShowAddListModalCommand}"
                CornerRadius="10"
                        Opacity="0.9"
                        Margin="10"/>

                <!-- Разделитель -->
                <BoxView HeightRequest="1"
                 Color="#3A2C6B"
                 Margin="10,0"/>

                <!-- Заголовок -->
                <Label Text="Списки"
               TextColor="White"
               FontSize="16"
               HorizontalOptions="Center"
               Margin="0,15,0,10"/>

                <!-- Список всех списков задач -->
                <CollectionView ItemsSource="{Binding TaskLists}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedList}"
                        BackgroundColor="Transparent"
                                Opacity="0.9">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Простой элемент списка -->
                            <Frame Padding="15,10"
                           BackgroundColor="Transparent"
                           Margin="10,5,10,5"
                           CornerRadius="8">

                                <Label Text="{Binding Name}"
                               TextColor="White"
                               FontSize="14"
                               VerticalOptions="Center"/>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Если списков нет -->
                    <CollectionView.EmptyView>
                        <StackLayout Padding="20,40"
                             HorizontalOptions="Center">

                            <Label Text="📭"
                           FontSize="40"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Opacity="0.5"/>

                            <Label Text="Списков пока нет"
                           TextColor="White"
                           FontSize="14"
                           HorizontalOptions="Center"
                           Opacity="0.7"
                           Margin="0,10,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </StackLayout>
        </Frame>
        
    </Grid>
</ContentPage>