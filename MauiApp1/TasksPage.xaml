<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TasksPage"
             Title="Задачи">

    <Grid RowDefinitions="Auto, *"
          ColumnDefinitions="Auto, *"
          BackgroundColor="#F5F5F5">

        <!-- ШАПКА -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
              BackgroundColor="#00008B"
              HeightRequest="60">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка панели -->
            <Button Grid.Column="0"
                    Text="☰"
                    BackgroundColor="Transparent"     
                    WidthRequest="60"
                    HeightRequest="60"
                    TextColor="White"
                    FontSize="20"
                    Command="{Binding ToggleSidePanelCommand}"/>

            <!-- Название текущего списка -->
            <Label Grid.Column="1"
                   Text="{Binding SelectedList.Name, StringFormat='📋 {0}'}"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <!-- Кнопка добавления задачи -->
            <Button Grid.Column="2"
                    Text="+ Задача"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    WidthRequest="100"
                    HeightRequest="40"
                    CornerRadius="20"
                    Margin="0,0,20,0"
                    VerticalOptions="Center"
                    Command="{Binding ShowAddTaskModalCommand}"/>
        </Grid>

        <!-- ЛЕВАЯ ПАНЕЛЬ СО СПИСКАМИ -->
        <Frame x:Name="SidePanel"
               Grid.Row="1" Grid.Column="0"
               WidthRequest="{Binding SidePanelWidth}"
               BackgroundColor="#201739"
               Padding="0"
               CornerRadius="0"
               IsVisible="{Binding IsSidePanelVisible}">

            <StackLayout Spacing="0">

                <!-- Заголовок -->
                <Label Text="📂 Списки задач"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,15,0,20"/>

                <!-- Кнопка создания списка -->
                <Button Text="+ Создать список"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45"
                        Margin="10"
                        Command="{Binding ShowAddListModalCommand}"/>

                <!-- Список всех списков -->
                <CollectionView ItemsSource="{Binding TaskLists}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedList}"
                                Margin="10,15,10,0"
                                BackgroundColor="Transparent">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,8">
                                <Frame BackgroundColor="{Binding Color, Converter={StaticResource ColorConverter}}"
                                       Padding="12"
                                       CornerRadius="8">

                                    <Grid ColumnDefinitions="*, Auto"
                                          ColumnSpacing="10">

                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextColor="White"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"/>

                                        <Label Grid.Column="1"
                                               Text="{Binding TaskCount}"
                                               TextColor="White"
                                               FontSize="12"
                                               Opacity="0.8"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Если списков нет -->
                    <CollectionView.EmptyView>
                        <Label Text="📭 Списков пока нет"
                               TextColor="White"
                               FontSize="14"
                               HorizontalOptions="Center"
                               Margin="0,30"
                               Opacity="0.7"/>
                    </CollectionView.EmptyView>
                </CollectionView>

            </StackLayout>
        </Frame>

        <!-- ПРАВАЯ ПАНЕЛЬ С ЗАДАЧАМИ -->
        <Grid Grid.Row="1" Grid.Column="1"
              BackgroundColor="White"
              Padding="20">

            <!-- Список задач -->
            <CollectionView ItemsSource="{Binding Tasks}"
                            BackgroundColor="Transparent">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15"
                               Margin="0,8"
                               BackgroundColor="#F0F8FF"
                               CornerRadius="10">

                            <Grid ColumnDefinitions="Auto, *, Auto"
                                  ColumnSpacing="12">

                                <!-- Чекбокс выполнения -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsCompleted}"
                                          Color="#007ACC"
                                          VerticalOptions="Center"
                                          CheckedChanged="OnTaskCheckedChanged"/>

                                <!-- Информация о задаче -->
                                <StackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">

                                    <Label Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsCompleted}"
                                                         Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="#666666" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <!-- Описание задачи -->
                                    <Label Text="{Binding Description}"
                                           FontSize="13"
                                           TextColor="#666666"
                                           IsVisible="{Binding Description, Converter={StaticResource NullToBoolConverter}}"/>
                                </StackLayout>

                                <!-- Кнопка удаления -->
                                <Button Grid.Column="2"
                                        Text="✕"
                                        BackgroundColor="Transparent"
                                        TextColor="#FF4444"
                                        FontSize="16"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        CornerRadius="20"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                         Path=BindingContext.DeleteTaskCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Если задач нет -->
                <CollectionView.EmptyView>
                    <StackLayout Padding="40"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                        <Label Text="📝"
                               FontSize="60"
                               TextColor="#DDDDDD"
                               HorizontalOptions="Center"/>
                        <Label Text="Задач нет в этом списке"
                               FontSize="16"
                               TextColor="#999999"
                               HorizontalOptions="Center"
                               Margin="0,15,0,0"/>
                        <Button Text="Добавить первую задачу"
                                BackgroundColor="#007ACC"
                                TextColor="White"
                                HeightRequest="45"
                                CornerRadius="10"
                                Margin="0,20"
                                Command="{Binding ShowAddTaskModalCommand}"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

        </Grid>

    </Grid>
</ContentPage>