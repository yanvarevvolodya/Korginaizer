<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TasksPage"
             Title="Задачи">

    <Grid ColumnDefinitions="70, *"  
          RowDefinitions="Auto, *"
          RowSpacing="0">

        <!-- Боковая панель -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
              BackgroundColor="#000033"
              x:Name="SidePanel"
              ZIndex="999">
            <StackLayout Padding="0,40,0,0">
                <Button ImageSource="tasks_icon.png" Text="Задачи" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnTasksButtonClicked"/>

                <Button ImageSource="calendar_icon.png" Text="Календарь" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnCalendarButtonClicked"/>

                <Button ImageSource="settings_icon.png" Text="Настройки" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnSettingsButtonClicked"/>
            </StackLayout>
        </Grid>

        <!-- Шапка контента ТОЛЬКО для задач -->
        <Grid Grid.Row="0" Grid.Column="1"
              BackgroundColor="#00008B"
              HeightRequest="60">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Кнопка выдвижения зеленой панели - ТОЛЬКО ДЛЯ ЗАДАЧ -->
            <Button Grid.Column="0"
                    Text="☰"
                    BackgroundColor="Transparent"
                    WidthRequest="60"
                    x:Name="ToggleCategoriesButton"
                    Clicked="OnToggleCategoriesButtonClicked"/>

            <Label x:Name="HeaderTitleLabel" Grid.Column="1"
                   Text="Задачи" 
                   VerticalOptions="Center" 
                   HorizontalOptions="Start"
                   FontSize="18"
                   TextColor="White"
                   FontAttributes="Bold"
                   Margin="30,0"/>
        </Grid>

        <!-- Основной контент С ЗЕЛЕНОЙ ПАНЕЛЬЮ И ЗАДАЧАМИ -->
        <Grid Grid.Row="1" Grid.Column="1"
              ColumnDefinitions="200, *" 
              RowDefinitions="*">

            <!-- Зелёная панель (навигация по спискам) - ТОЛЬКО ДЛЯ ЗАДАЧ -->
            <Grid x:Name="CategoriesPanel" 
                  Grid.Column="0" 
                  BackgroundColor="#000062"
                  TranslationX="-200"
                  ZIndex="1">
                <StackLayout Spacing="10" Padding="10,40,10,0">
                    <Button Text="Создать список" BackgroundColor="#000033" TextColor="White"/>
                    <Label Text="Мои списки:" TextColor="White" FontAttributes="Bold"/>
                    <Button Text="Личные" BackgroundColor="Transparent" TextColor="White"/>
                    <Button Text="Работа" BackgroundColor="Transparent" TextColor="White"/>
                    <Button Text="Покупки" BackgroundColor="Transparent" TextColor="White"/>
                </StackLayout>
            </Grid>

            <!-- ОБЛАСТЬ ЗАДАЧ (основное содержимое) - ТОЛЬКО ДЛЯ ЗАДАЧ -->
            <ScrollView x:Name="TasksArea" 
                        Grid.Column="0" Grid.ColumnSpan="2"
                        ZIndex="0">
                <StackLayout Padding="20" x:Name="TasksContainer">
                    <Label Text="Список задач..." FontSize="16" TextColor="White"/>
                    <Frame BackgroundColor="#f5f5f5" Padding="15">
                        <Label Text="Пример задачи 1"/>
                    </Frame>
                    <Frame BackgroundColor="#f5f5f5" Padding="15">
                        <Label Text="Пример задачи 2"/>
                    </Frame>
                </StackLayout>
            </ScrollView>

        </Grid>

    </Grid>
</ContentPage>