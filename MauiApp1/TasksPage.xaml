<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TasksPage"
             Title="Задачи">
    <Grid RowDefinitions="Auto, *, Auto"
          Padding="15">
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="15">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <Picker x:Name="CategoryFilter"
                            Grid.Column="0"
                            ItemsSource="{Binding TaskCategories}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategory}"
                            HorizontalOptions="FillAndExpand"/>
                    <Button Text="+"
                            Grid.Column="1"
                            Command="{Binding AddCategoryCommand}"
                            WidthRequest="50"/>
                    <Button Grid.Column="2"
                            Text="⚙️"
                            Command="{Binding ManageCategoriesCommand}"
                            WidthRequest="50"/>
                </Grid>

                <!-- Список задач -->
                <CollectionView ItemsSource="{Binding Tasks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{AppThemeBinding Light=Transparent, Dark=Transparent}">
                                <Grid Padding="10"
                                      ColumnDefinitions="Auto, *, Auto, Auto"
                                      BackgroundColor="{AppThemeBinding Light=LightBlue, Dark=#374045}"
                                      Margin="0,2"
                                      RowDefinitions="Auto, Auto">

                                    <!-- CheckBox -->
                                    <CheckBox Grid.Row="0" Grid.Column="0"
                                              Grid.RowSpan="2"
                                              IsChecked="{Binding IsCompleted}"
                                              Color="#007ACC"
                                              CheckedChanged="OnTaskCheckedChanged"/>

                                    <!-- Текст задачи -->
                                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="16">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsCompleted}"
                                                             Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="TextColor" Value="#6C757D" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- Дата и описание -->
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Label Grid.Column="0"
                                                   Text="📝"
                                                   FontSize="10"
                                                   IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}"
                                                   Margin="0,0,5,0"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding FormattedDueDateTime}"
                                                   FontSize="12"
                                                   IsVisible="{Binding HasDueDateTime}"/>
                                        </Grid>
                                    </StackLayout>

                                    <Label Grid.Column="2"
                                           Text="{Binding CategoryName}"
                                           FontSize="11"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"
                                           Margin="0,0,20,0"
                                           TextColor="{AppThemeBinding Light=#555, Dark=#AAA}"
                                           IsVisible="{Binding CategoryName, Converter={StaticResource StringToBoolConverter}}"/>

                                    <Button Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.RowSpan="2"
                                            Text="⋯"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                            FontSize="19"
                                            WidthRequest="50"
                                            BorderColor="Transparent"
                                            Command="{Binding Path=BindingContext.ShowTaskMenuCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Stroke="{AppThemeBinding Light=#e9e9f7, Dark=#374045}"
                Background="{AppThemeBinding Light=Transparent, Dark=#374045}">
            <Grid  
              ColumnDefinitions="*, Auto">
                <Entry Placeholder="Добавить задачу..."
                   Grid.Column="0"
                   Text="{Binding NewTaskTitle}" 
                   Completed="OnEntryCompleted"/>

                <Button Grid.Column="1"
                    Text="+ Задача"
                    Command="{Binding AddTaskCommand}"
                    WidthRequest="90"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>