<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.KanbanPage">

    <Grid RowDefinitions="Auto, *">
        <!-- ШАПКА -->
        <Grid Grid.Row="0"
              BackgroundColor="Transparent"
              Padding="15"
              HeightRequest="70">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Выбор доски -->
            <Picker Grid.Column="0"
                    ItemsSource="{Binding Boards}"
                    SelectedItem="{Binding SelectedBoard}"
                    ItemDisplayBinding="{Binding Name}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}"
                    HorizontalOptions="Start"/>

            <!-- Кнопка +Доска -->
            <Button Grid.Column="1"
                    Text="+ Доска"
                    BackgroundColor="Transparent"
                    Margin="0,0,10,0"
                    Command="{Binding AddBoardCommand}"/>

            <!-- Кнопка +Столбец -->
            <Button Grid.Column="2"
                    Text="+ Столбец"
                    CornerRadius="20"
                    Padding="15,0"
                    TextColor="White"
                    Command="{Binding AddColumnCommand}"
                    IsEnabled="{Binding SelectedBoard, Converter={StaticResource NullToBoolConverter}}"/>
        </Grid>

        <!-- КАНБАН ДОСКА -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Always"
                    Padding="10">

            <StackLayout Orientation="Horizontal"
                         Spacing="15"
                         BindableLayout.ItemsSource="{Binding Columns}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <!-- СТОЛБЕЦ -->
                        <Frame WidthRequest="300"
                               BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2d2d2d}"
                               CornerRadius="10"
                               Padding="0">

                            <Grid RowDefinitions="Auto, *, Auto"
                                  RowSpacing="0">

                                <!-- Заголовок столбца -->
                                <Frame Grid.Row="0"
                                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1a237e}"
                                       CornerRadius="10"
                                       Padding="15,10">

                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#007ACC, Dark=White}"/>

                                        <Label Grid.Column="1"
                                               Text="{Binding CardCount, StringFormat='({0})'}"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                               FontSize="14"/>
                                    </Grid>
                                </Frame>

                                <!-- Карточки в столбце -->
                                <CollectionView Grid.Row="1"
                                                ItemsSource="{Binding Cards}"
                                                Margin="10"
                                                VerticalOptions="FillAndExpand">

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- КАРТОЧКА -->
                                            <Frame Padding="15"
                                                   Margin="0,0,0,10"
                                                   BackgroundColor="{Binding Color}"
                                                   CornerRadius="8"
                                                   HasShadow="True">

                                                <StackLayout Spacing="5">
                                                    <!-- Заголовок -->
                                                    <Label Text="{Binding Title}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="White"
                                                           LineBreakMode="WordWrap"/>

                                                    <!-- Описание -->
                                                    <Label Text="{Binding Description}"
                                                           FontSize="12"
                                                           TextColor="#FFFFFF"
                                                           Opacity="0.9"
                                                           LineBreakMode="WordWrap"
                                                           IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}"/>

                                                    <!-- Кнопка удаления -->
                                                    <Button Text="✕"
                                                            BackgroundColor="Transparent"
                                                            TextColor="White"
                                                            FontSize="12"
                                                            HorizontalOptions="End"
                                                            WidthRequest="30"
                                                            HeightRequest="30"
                                                            Command="{Binding Path=BindingContext.DeleteCardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                            CommandParameter="{Binding .}"/>
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>

                                    <CollectionView.EmptyView>
                                        <StackLayout Padding="20"
                                                     HorizontalOptions="Center">
                                            <Label Text="📭"
                                                   FontSize="40"
                                                   TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Карточек пока нет"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"
                                                   HorizontalOptions="Center"
                                                   Margin="0,10,0,0"/>
                                        </StackLayout>
                                    </CollectionView.EmptyView>
                                </CollectionView>

                                <!-- Кнопка добавления карточки -->
                                <Button Grid.Row="2"
                                        Text="+ Добавить карточку"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#007ACC, Dark=#64b5f6}"
                                        Margin="10"
                                        CornerRadius="5"
                                        BorderColor="{AppThemeBinding Light=#007ACC, Dark=#64b5f6}"
                                        BorderWidth="1"
                                        HeightRequest="40"
                                        Command="{Binding Path=BindingContext.AddCardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>