<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.KanbanPage"
             x:Name="PageRoot">

    <Grid RowDefinitions="Auto, *" x:Name="RootGrid">
        <!-- ШАПКА (оставляем без изменений) -->
        <Grid Grid.Row="0"
              BackgroundColor="Transparent"
              Padding="15"
              HeightRequest="70">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Выбор доски -->
            <Grid Grid.Column="0" ColumnDefinitions="*, Auto">
                <Picker Grid.Column="0"
                        ItemsSource="{Binding Boards}"
                        SelectedItem="{Binding SelectedBoard}"
                        ItemDisplayBinding="{Binding Name}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        HorizontalOptions="Start"/>

                <Button Grid.Column="1"
                        ImageSource="delete_red.png"
                        FontSize="{OnPlatform WinUI=12}"
                        WidthRequest="56"
                        HeightRequest="50"
                        BorderColor="Transparent"
                        BackgroundColor="Transparent"
                        Margin="5,0,0,0"
                        Command="{Binding DeleteBoardCommand}"
                        CommandParameter="{Binding SelectedBoard}"
                        IsEnabled="{Binding SelectedBoard, Converter={StaticResource NullToBoolConverter}}"/>
            </Grid>

            <Button Grid.Column="1"
                    ImageSource="{AppThemeBinding Light=add_ad_blue.png, Dark=add_ad_white.png}"
                    WidthRequest="60"
                    HeightRequest="50"
                    
                    BorderColor="Transparent"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    Margin="0,0,10,0"
                    Command="{Binding AddBoardCommand}"/>

            <Button Grid.Column="2"
                    ImageSource="add_column_white.png"
                    
                    CornerRadius="20"
                    Padding="15,0"
                    TextColor="White"
                    Command="{Binding AddColumnCommand}"
                    IsEnabled="{Binding SelectedBoard, Converter={StaticResource NullToBoolConverter}}"/>
        </Grid>

        <!-- КАНБАН ДОСКА - УПРОЩЕННАЯ ВЕРСИЯ -->
        <CollectionView Grid.Row="1"
                        x:Name="ColumnsCollectionView"
                        ItemsSource="{Binding Columns}"
                        HorizontalScrollBarVisibility="Always"
                        VerticalScrollBarVisibility="Never"
                        Margin="10">

            <!-- Горизонтальная раскладка -->
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- СТОЛБЕЦ (упрощенный) -->
                    <Frame WidthRequest="320"
                           BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#2d2d2d}"
                           CornerRadius="10"
                           Padding="0"
                           Margin="0,0,0,10">

                        <Grid RowDefinitions="Auto, *, Auto"
                              RowSpacing="0"
                              >

                            <!-- Заголовок столбца -->
                            <Frame Grid.Row="0"
                                   BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1a237e}"
                                   CornerRadius="10"
                                   Padding="10"
                                   HeightRequest="60">

                                <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                    <!-- Кнопка перемещения влево -->
                                    <Button Grid.Column="0"
                                            ImageSource="{AppThemeBinding Light=left_blue.png, Dark=left_white.png}"
                                            BackgroundColor="Transparent"
                                            BorderColor="Transparent"
                                            WidthRequest="56"
                                            HeightRequest="50"
                                            Command="{Binding Path=BindingContext.MoveColumnLeftCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Position, Converter={StaticResource GreaterThanZeroConverter}}"/>

                                    <!-- Название -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#007ACC, Dark=White}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>

                                
                                    
                                    <!-- Кнопка удаления -->
                                    <Button Grid.Column="2"
                                            BackgroundColor="Transparent"
                                            ImageSource="delete_red.png"
                                            FontSize="{OnPlatform WinUI=12}"
                                            WidthRequest="56"
                                            HeightRequest="50"
                                            BorderColor="Transparent"
                                            Margin="10,0,0,0"
                                            Command="{Binding Path=BindingContext.DeleteColumnCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"/>

                                    <!-- Кнопка перемещения вправо -->
                                    <Button Grid.Column="3"
                                            ImageSource="{AppThemeBinding Light=right_blue.png, Dark=right_white.png}"
                                            BackgroundColor="Transparent"
                                            WidthRequest="56"
                                            HeightRequest="50"
 
                                            BorderColor="Transparent"
                                            Margin="10,0,0,0"
                                            Command="{Binding Path=BindingContext.MoveColumnRightCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}"
                                            IsEnabled="{Binding Position, Converter={StaticResource LessThanMaxConverter}}"/>

                                    
                                </Grid>
                            </Frame>

                            <!-- Карточки (упрощенный CollectionView) -->
                            <CollectionView Grid.Row="1"
                                            ItemsSource="{Binding Cards}"
                                            Margin="10,5,10,5"
                                            VerticalScrollBarVisibility="Always"
                                            VerticalOptions="FillAndExpand">

                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <!-- УПРОЩЕННАЯ КАРТОЧКА -->
                                        <Frame Padding="12"
           Margin="0,0,0,8"
           BackgroundColor="{Binding Color}"
           CornerRadius="6"
           HasShadow="False"
           HeightRequest="95">
                                            <!-- Увеличиваем высоту для даты -->

                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto"
              ColumnSpacing="2">

                                                <!-- Кнопка вверх -->
                                                <Button Grid.Column="0"
                    Text="↑"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="10"
                    WidthRequest="22"
                    HeightRequest="22"
                    Padding="0"
                    Command="{Binding Path=BindingContext.MoveCardUpCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}"/>

                                                <!-- Основное содержимое -->
                                                <VerticalStackLayout Grid.Column="1"
                                 Spacing="1"
                                 VerticalOptions="Center">
                                                    <Label Text="{Binding Title}"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="TailTruncation"
                       MaxLines="2"/>

                                                    <Label Text="{Binding Description}"
                       FontSize="11"
                       TextColor="#FFFFFF"
                       Opacity="0.8"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"
                       IsVisible="{Binding Description, Converter={StaticResource StringToBoolConverter}}"/>

                                                    <!-- Отображение даты и времени -->
                                                    <Label Text="{Binding FormattedDueDateTime}"
                       FontSize="11"
                       TextColor="#FFFFFF"
                       Opacity="0.7"
                       IsVisible="{Binding HasDueDateTime}"/>
                                                </VerticalStackLayout>

                                                <!-- Кнопка вниз -->
                                                <Button Grid.Column="2"
                    Text="↓"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="10"
                    WidthRequest="22"
                    HeightRequest="22"
                    Padding="0"
                    Command="{Binding Path=BindingContext.MoveCardDownCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}"/>

                                                <!-- Кнопка перемещения -->
                                                <Button Grid.Column="3"
                    Text="↷"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="11"
                    WidthRequest="24"
                    HeightRequest="24"
                    Padding="0"
                    Command="{Binding Path=BindingContext.MoveCardToColumnCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}"/>

                                                <!-- Кнопка календаря -->
                                                <Button Grid.Column="4"
                    ImageSource="calendar_white.png"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="11"
                    WidthRequest="24"
                    HeightRequest="24"
                    Padding="0"
                    Command="{Binding Path=BindingContext.SetDueDateCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}"/>

                                                <!-- Кнопка удаления -->
                                                <Button Grid.Column="5"
                    Text="✕"
                    BackgroundColor="Transparent"
                    TextColor="#FF4444"
                    FontSize="11"
                    WidthRequest="24"
                    HeightRequest="24"
                    Padding="0"
                    Command="{Binding Path=BindingContext.DeleteCardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                    CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>

                                <CollectionView.EmptyView>
                                    <StackLayout Padding="0"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                        <Label Text="📭"
                                               FontSize="30"
                                               TextColor="{AppThemeBinding Light=#CCCCCC, Dark=#666666}"
                                               HorizontalOptions="Center"/>
                                        <Label Text="Нет карточек"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"
                                               HorizontalOptions="Center"
                                               Margin="0,5,0,0"/>
                                    </StackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>

                            <!-- Кнопка добавления карточки (упрощенная) -->
                            <Button Grid.Row="2"
                                    Text="+"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#007ACC, Dark=#64b5f6}"
                                    Margin="10,5"
                                    CornerRadius="30"
                                    BorderColor="{AppThemeBinding Light=#007ACC, Dark=#64b5f6}"
                                    BorderWidth="1"
                                    HeightRequest="45"
                                    WidthRequest="45"
                                    FontSize="{OnPlatform WinUI=18, Android=18}"
                                    HorizontalOptions="Center"
                                    Command="{Binding Path=BindingContext.AddCardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>