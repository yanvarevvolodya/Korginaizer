<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Шапка -->
        <Grid Grid.Row="0" 
              BackgroundColor="#007ACC" 
              HeightRequest="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Text="☰"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    FontSize="18"
                    Clicked="OnMenuClicked"/>

            <Label Grid.Column="1"
                   Text="label"
                   TextColor="White"
                   FontSize="20"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"/>

            <!-- Добавляем после Label -->
            <Button Grid.Column="2"
        Text="Настройки"
        TextColor="White"
        BackgroundColor="Transparent"
        FontSize="16"
        Clicked="OnSettingsClicked"/>
        </Grid>

        <!-- Основной контент -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="20" Spacing="15">

                <!-- Быстрое добавление задачи -->
                <Frame BackgroundColor="#f5f5f5" >
                    <StackLayout Spacing="10">
                        <Label Text="Новая задача" FontSize="16" FontAttributes="Bold"/>
                        <Entry x:Name="NewTaskEntry" 
                               Placeholder="Что нужно сделать?"
                               BackgroundColor="White"/>
                        <Button Text="Добавить" 
                                Clicked="OnAddTaskClicked"
                                BackgroundColor="#007ACC"
                                TextColor="White"/>
                    </StackLayout>
                </Frame>

                <!-- Список задач -->
                <StackLayout>
                    <Label Text="Мои задачи" FontSize="18" FontAttributes="Bold"/>
                    <!-- Здесь потом будет список -->
                    <Label Text="Задачи появятся здесь..."
                           FontSize="14"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           Margin="0,20"/>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Нижнее меню (для мобильных) -->
        <Grid Grid.Row="2" 
              BackgroundColor="#f0f0f0"
              HeightRequest="50"
              IsVisible="False">
            <!-- Пока скрываем -->
            <!-- Сделаем позже -->
        </Grid>

    </Grid>
</ContentPage>