<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.CalendarPage"
             Title="Календарь">

    <Grid ColumnDefinitions="70, *"  
          RowDefinitions="Auto, *"
          RowSpacing="0">

        <!-- Боковая панель (такая же) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
              BackgroundColor="#000033"
              ZIndex="999">
            <StackLayout Padding="0,40,0,0">
                <Button ImageSource="tasks_icon.png" Text="Задачи" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnTasksButtonClicked"/>

                <Button ImageSource="calendar_icon.png" Text="Календарь" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnCalendarButtonClicked"/>

                <Button ImageSource="settings_icon.png" Text="Настройки" 
                        BackgroundColor="Transparent" TextColor="White" 
                        HeightRequest="70"
                        Clicked="OnSettingsButtonClicked"/>
            </StackLayout>
        </Grid>

        <!-- Шапка контента БЕЗ кнопки зеленой панели -->
        <Grid Grid.Row="0" Grid.Column="1"
        BackgroundColor="#00008B"
        HeightRequest="60">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

            <Label x:Name="HeaderTitleLabel" Grid.Column="1"
     Text="Календарь" 
     VerticalOptions="Center" 
     HorizontalOptions="Start"
     FontSize="18"
     TextColor="White"
     FontAttributes="Bold"
     Margin="30,0"/>
        </Grid>

        <!-- Основной контент календаря -->
        <ScrollView Grid.Row="1" Grid.Column="1">
            <StackLayout Padding="20">
                <Label Text="Календарь будет здесь..." 
                       FontSize="16" 
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>