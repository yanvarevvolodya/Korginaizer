<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.CalendarPage"
             Title="Календарь"
             x:Name="CalendarPageRoot">

    <Grid RowDefinitions="Auto, Auto, *, Auto"
          ColumnDefinitions="*"
          Padding="20"
          RowSpacing="15">

        <!-- ========== ЗАГОЛОВОК МЕСЯЦА ========== -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto, *, Auto"
              VerticalOptions="Center">

            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    TextColor="#007ACC"
                    WidthRequest="50"
                    Command="{Binding PreviousMonthCommand}"/>

            <Label Grid.Column="1"
                   Text="{Binding CurrentMonthYear}"
                   FontSize="20"
                   FontAttributes="Bold"
                   
                   HorizontalOptions="Center"/>

            <Button Grid.Column="2"
                    Text="›"
                    BorderColor="Transparent"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    TextColor="#007ACC"
                    WidthRequest="50"
                    Command="{Binding NextMonthCommand}"/>
        </Grid>

        <!-- ========== ДНИ НЕДЕЛИ ========== -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*, *, *, *, *, *, *"
              ColumnSpacing="5">
            <Label Grid.Column="0" Text="Пн" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Grid.Column="1" Text="Вт" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Grid.Column="2" Text="Ср" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Grid.Column="3" Text="Чт" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Grid.Column="4" Text="Пт" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Grid.Column="5" Text="Сб" FontAttributes="Bold" HorizontalOptions="Center"/>
            <Label Grid.Column="6" Text="Вс" FontAttributes="Bold" HorizontalOptions="Center"/>
        </Grid>

        <!-- ========== КАЛЕНДАРЬ (Grid вместо CollectionView) ========== -->
        <ScrollView Grid.Row="2">
            <Grid x:Name="CalendarGrid"
                  RowDefinitions="*, *, *, *, *, *"
                  ColumnDefinitions="*, *, *, *, *, *, *"
                  RowSpacing="5"
                  ColumnSpacing="5"
                  Margin="0,10,0,0">
                <!-- Ячейки будут созданы в коде -->
            </Grid>
        </ScrollView>

        <!-- ========== СОБЫТИЯ НА ВЫБРАННЫЙ ДЕНЬ ========== -->
        <Frame Grid.Row="3"
               BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#302d2e}"
               Padding="15"
               CornerRadius="10"
               HasShadow="True">

            <Grid RowDefinitions="Auto, *">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0"
                           Text="{Binding SelectedDateText}"
                           FontSize="16"
                           FontAttributes="Bold"
                           />

                    <Button Grid.Column="1"
                            Text="+"
                            TextColor="White"
                            HeightRequest="35"
                            CornerRadius="8"
                            Command="{Binding AddEventCommand}"/>
                </Grid>

                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding EventsForSelectedDate}"
                                Margin="0,10,0,0"
                                HeightRequest="150">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="12"
                                   Margin="0,5,0,0"
                                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#374045}"
                                   CornerRadius="8"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#302e2f}">

                                <Grid ColumnDefinitions="Auto, *, Auto"
                                      ColumnSpacing="10">

                                    <StackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"/>

                                        <Label Text="{Binding DueTimeOnlyString}"
                                               FontSize="12"
                                               TextColor="Gray"
                                               IsVisible="{Binding DueDate.HasValue}"/>
                                    </StackLayout>

                                    <Button Grid.Column="2"
                                            Text="✕"
                                            BackgroundColor="Transparent"
                                            TextColor="#FF4444"
                                            FontSize="{OnPlatform WinUI=12}"
                                            WidthRequest="{OnPlatform WinUI=35}"
                                            HeightRequest="{OnPlatform WinUI=35}"
                                            CornerRadius="20"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, 
                                                             Path=BindingContext.DeleteEventCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <StackLayout Padding="20" HorizontalOptions="Center">
                            <Image Source="{AppThemeBinding Light=calendar_month_blue.png, Dark=calendar_month_gray.png}"
                                   HeightRequest="50"
                                   WidthRequest="50"/>

                            <Label Text="Задач на этот день нет"
                                   FontSize="14"
                                   TextColor="#999999"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>