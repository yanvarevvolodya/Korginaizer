<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.TodayPage"
             Title="План на день">
    <StackLayout Padding="15">
        <Grid ColumnDefinitions="Auto, *, Auto" HorizontalOptions="Center" Margin="0,0,0,20">
            <Button Grid.Column="0"
                    Text="‹"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    TextColor="#007ACC"
                    WidthRequest="50"
                    Command="{Binding PreviousDayCommand}"/>

            <DatePicker Grid.Column="1"
                        x:Name="DatePickerControl"
                        Date="{Binding SelectedDate, Mode=TwoWay}"
                        Format="dddd, d MMMM yyyy"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"/>

            <Button Grid.Column="2"
                    Text="›"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    BorderColor="Transparent"
                    TextColor="#007ACC"
                    WidthRequest="50"
                    Command="{Binding NextDayCommand}"/>
        </Grid>

        <Label Text="Задачи"
               FontSize="18"
               FontAttributes="Bold"
               IsVisible="{Binding HasTasks}"/>
        <CollectionView ItemsSource="{Binding TasksForDate}"
                        IsVisible="{Binding HasTasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10"
                          BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}"
                          Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Text="{Binding Title}"
                               FontSize="14"
                               VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsCompleted}"
                                             Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="TextColor" Value="Gray"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Label Grid.Column="1"
                               Text="{Binding DueTimeOnlyString}"
                               FontSize="12"
                               TextColor="Gray"
                               IsVisible="{Binding DueDate.HasValue}"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Нет задач на этот день"
               IsVisible="{Binding NoTasks}"
               TextColor="Gray"
               Margin="0,5,0,15"/>

        <Button Text="Все задачи"
                Command="{Binding OpenScheduleCommand}"
                WidthRequest="250"/>

    </StackLayout>
</ContentPage>